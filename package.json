{
  "name": "cabane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.11.1 <25",
    "npm": ">=11.6.2 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "home"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@cabane/web",
    "agent:dev": "node scripts/dev-agent.mjs",
    "agent:status": "node apps/agent-cli/src/cli.mjs status",
    "agent:inspect": "node apps/agent-cli/src/cli.mjs inspect",
    "agent:validate": "node apps/agent-cli/src/cli.mjs validate",
    "agent:request": "node apps/agent-cli/src/cli.mjs request",
    "agent:rename-room": "node apps/agent-cli/src/cli.mjs rename-room",
    "agent:undo": "node apps/agent-cli/src/cli.mjs undo",
    "agent:redo": "node apps/agent-cli/src/cli.mjs redo",
    "build": "npm run build --workspace=@cabane/web",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "verify:scene-contours": "node scripts/verify-scene-contours.mjs",
    "measure:scene": "node scripts/measure-scene-performance.mjs",
    "verify:furnishing-surfaces": "node scripts/verify-furnishing-surfaces.mjs",
    "verify:boundaries": "node scripts/verify-import-boundaries.mjs",
    "home:validate-floor": "node scripts/validate-floor.mjs",
    "home:verify": "npm run typecheck && npm run verify:boundaries && node scripts/verify-home.mjs",
    "home:preview": "npm run dev",
    "home:evidence": "node scripts/capture-visual-evidence.mjs",
    "fixture:verify:layout": "npm run home:verify -- --stage layout --fixture layout",
    "fixture:verify:room": "npm run home:verify -- --stage room --room-id fixture-studio --fixture room",
    "fixture:verify:scale": "npm run home:verify -- --stage scale --fixture scale",
    "fixture:preview:layout": "node scripts/fixture-preview.mjs --stage layout --scenario disconnected",
    "fixture:preview:room": "node scripts/fixture-preview.mjs --stage room --scenario disconnected",
    "fixture:preview:connected": "node scripts/fixture-preview.mjs --stage room --scenario connected",
    "fixture:preview:mapping": "node scripts/mapping-preview.mjs",
    "fixture:evidence": "node scripts/capture-visual-evidence.mjs --fixture all",
    "verify": "npm run verify:fast && npm test && npm run verify:furnishing-surfaces && npm run build",
    "build:panel": "node scripts/build-panel.mjs",
    "test:unit": "CABANE_TEST_SUITE=unit npm test",
    "test:browser": "CABANE_TEST_SUITE=browser npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "knip": "knip --config knip.config.mjs",
    "browser:install": "playwright-core install chromium --no-shell",
    "verify:fast": "npm run format:check && npm run lint && npm run typecheck && npm run knip && npm run verify:boundaries && npm run verify:ha-contract",
    "verify:help": "node scripts/verify-focused.mjs --help",
    "verify:workspace": "node scripts/verify-focused.mjs workspace",
    "verify:construct": "node scripts/verify-focused.mjs construct",
    "verify:runtime": "node scripts/verify-focused.mjs runtime",
    "verify:ha-contract": "node scripts/ha-contract.mjs",
    "contract:record": "node scripts/ha-contract.mjs --record",
    "release:ha-contract": "node scripts/release-ha-contract.mjs",
    "test:profile": "node scripts/profile-tests.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "ha:up": "node scripts/ha-dev.mjs up",
    "ha:down": "docker compose -f dev/home-assistant/compose.yaml down",
    "ha:logs": "docker compose -f dev/home-assistant/compose.yaml logs --tail=100 -f",
    "ha:check": "docker compose -f dev/home-assistant/compose.yaml exec homeassistant python -m homeassistant --script check_config --config /config",
    "ha:refresh": "node scripts/ha-dev.mjs refresh",
    "agent:pair": "node apps/agent-cli/src/cli.mjs pair"
  },
  "devDependencies": {
    "@react-three/test-renderer": "9.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "27.4.0",
    "knip": "6.41.0",
    "playwright-core": "1.62.1",
    "prettier": "3.9.9",
    "three": "0.182.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.4.0",
    "typescript-eslint": "8.71.1",
    "typescript-native": "npm:typescript@7.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.3",
    "home-assistant-js-websocket": "9.6.0",
    "@react-three/drei": "10.7.8",
    "three-stdlib": "2.36.1",
    "postcss": "8.5.26",
    "fflate": "0.8.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.11.1 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.6.2 <12",
      "onFail": "error"
    }
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
